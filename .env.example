# Cozypet — ตัวแปรฝั่ง server ทั้งหมด (ห้ามใช้ prefix NEXT_PUBLIC_ ห้าม commit ค่าจริง)
# คัดลอกเป็น .env.local แล้วเติมค่าในเครื่อง หรือตั้งใน Vercel Environment Variables

# --- AI provider (งบ 0 บาท: ใช้ free tier/รุ่นฟรีเท่านั้น) ---
# demo (ค่าเริ่มต้น ไม่เรียก API) | gemini | groq | openrouter
AI_PROVIDER=demo
# model ID ของ provider ที่เลือก (ไม่มีค่า default ในโค้ด ตรวจเอกสารทางการก่อนตั้ง)
# OpenRouter ต้องลงท้าย :free เท่านั้น
AI_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Rate limit (ต้องต่ำกว่าโควตาฟรีรายวันของรุ่นที่เลือก) ---
CHAT_RATE_LIMIT_PER_MIN=6
CHAT_RATE_LIMIT_PER_DAY=40
CHAT_GLOBAL_DAILY_LIMIT=300
ASSIST_RATE_LIMIT_PER_MIN=10
ASSIST_GLOBAL_DAILY_LIMIT=200

# --- บัญชีผู้ใช้ (Supabase ฟรี) ถ้าว่าง ระบบบัญชีปิดและใช้โหมดทดลองได้ครบ ---
# ห้ามใส่ service role / secret key ที่ใดเลย
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
AUTH_PASSWORD_RESET_ENABLED=false
